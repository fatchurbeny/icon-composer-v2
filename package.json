{
  "name": "icon-composer-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/icon-studio",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "icon-data": "node scripts/build-icon-data.mjs",
    "legacy:verify": "shasum -a 256 -c docs/legacy/legacy.sha256",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "golden:capture": "node scripts/golden-capture.mjs",
    "test:golden": "npm run build && playwright test --grep @golden",
    "lint": "eslint . && npm run lint:ui",
    "lint:ui": "node scripts/lint-ui.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.55.1",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "lucide-static": "^1.52.0",
    "prettier": "3.6.2",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  }
}
